FROM eclipse-temurin:25-jdk
WORKDIR /workspace/app

COPY gradlew .
COPY gradle gradle
COPY settings.gradle .
COPY build.gradle .
COPY src src
COPY DSL DSL

RUN chmod 754 ./gradlew

# ShellExecuteJob.execProcess hardcodes /app as its working directory; create it so that test runs instead of skipping.
RUN mkdir -p /app

RUN ./gradlew test
